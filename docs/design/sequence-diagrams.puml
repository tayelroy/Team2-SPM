@startuml seq-1-availability-and-booking-decision
title Seq 1 — Availability check and booking decision with setup & turnaround (SG2-78/79)\nas of main 1d1e336 (14 Oct 2026)
skinparam sequenceMessageAlign left
skinparam noteBackgroundColor #FFF4CC
skinparam ParticipantPadding 6
skinparam BoxPadding 4
actor "Venue Staff" as VS
participant "Web App\nAvailabilityCalendar /\nVenueDecision" as WEB
participant "API\ncreateAllVenuesAvailabilityHandler\n+ venue-booking-requests router" as API
database "Supabase Postgres" as DB

== Availability check (SG2-78) ==
VS -> WEB : open availability calendar (month)
WEB -> API : GET /api/venues/availability?from&to\n[venues.availability.view]
API -> DB : getAllVenuesAvailability (caller JWT):\nselect venues, venue_booking_occupancy,\nvenue_unavailability, venue_affected_bookings,\nvenue_operations
DB --> API : rows
API -> API : preparationByVenue + effectivePeriod:\nadd 'setup' / 'turnaround' bands\naround each booking and hold
note right of API #FFF4CC : <<Week 7>> SG2-78\nsetup_minutes / turnaround_minutes\nfrom venue_operations (SG2-77)
API --> WEB : 200 entries (booking | hold | unavailable | setup | turnaround)

== Booking decision (SG2-78) ==
VS -> WEB : approve pending request
WEB -> API : POST /api/venue-booking-requests/:requestId/decision\n{decision:'approve'} [venue_booking.decide]
API -> DB : request still pending? linked venue_holds row?
alt not pending / is a hold
  API --> WEB : 409
else
  API -> API : assessSuitability + bookingReadiness\n(facility blocked / capacity exception needed -> 409)
  API -> DB : rpc decide_venue_booking_request(p_request_id, p_decision, p_reason)
  activate DB
  DB -> DB : lock venues row, request, event\ngap := venue_preparation_gap(venue_id)
  DB -> DB : clash = confirmed venue_bookings within +/- gap\nor venue_unavailability overlap\nor live tentative venue_holds within +/- gap
  alt clash found
    DB --> API : {outcome:'conflict', kind, starts_at, ends_at, label}
    API --> WEB : 409 + conflict
  else no clash and capacity ok
    DB -> DB : insert venue_bookings (confirmed)\nupdate events.venue_booking_id (keep earliest, SG2-82)\nupdate venue_booking_requests -> approved\ninsert event_audit_logs, notifications (coordinator)
    DB -> DB : trigger venue_bookings_refresh_clashes\n-> refresh_venue_booking_clashes(venue_id)
    note right of DB #FFF4CC : <<Week 7>> SG2-79\nflags pairs closer than setup+turnaround\nin venue_booking_clashes, notifies\ncoordinators ('venue_booking_clash')
    DB --> API : {outcome:'updated', ...}
    deactivate DB
    API --> WEB : 200
  end
end

== Existing clashes (SG2-79) ==
VS -> WEB : open booking clashes
WEB -> API : GET /api/venue-clashes [venue_clashes.view]
API -> DB : createVenueClashStore.list: select venue_booking_clashes
API --> WEB : clashesFor(rows, principal)

legend right
  |= Colour |= Meaning |
  |<#FFF4CC>| <<Week 7>> addition |
  |<#DDDDDD>| <<planned>> not built (dashed) |
endlegend
@enduml

