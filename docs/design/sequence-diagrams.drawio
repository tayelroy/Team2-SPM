e=8;exitX=0.5;exitY=0.9471;exitDx=0;exitDy=0;entryX=0.5;entryY=0.9550;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_DB" target="p_DB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1492" y="2490"/><mxPoint x="1492" y="2510"/></Array><mxPoint x="-32" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="m63" value="confirmed, or conflict -&amp;gt; 409" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;align=left;edgeStyle=none;rounded=0;strokeColor=#333333;endArrow=open;endFill=0;endSize=8;exitX=0.5;exitY=0.9680;exitDx=0;exitDy=0;entryX=0.5;entryY=0.9680;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p_DB" target="p_API"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="-174" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="m64" value="200 / 409" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontSize=10;align=left;edgeStyle=none;rounded=0;strokeColor=#333333;endArrow=open;endFill=0;endSize=8;exitX=0.5;exitY=0.9818;exitDx=0;exitDy=0;entryX=0.5;entryY=0.9818;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p_API" target="p_WEB"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="-180" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="n65" value="«Week 7» The same refresh returns the event to&lt;br&gt;planning if an arrangement is later added,&lt;br&gt;released or disrupted." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFF4CC;strokeColor=#B8A13A;" vertex="1" parent="1"><mxGeometry x="1466" y="631" width="272" height="51" as="geometry"/></mxCell><mxCell id="n66" value="Every outcome writes event_audit_logs and a&lt;br&gt;safety_decision notice to the coordinator and organiser." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFF4CC;strokeColor=#B8A13A;" vertex="1" parent="1"><mxGeometry x="1466" y="1660" width="354" height="38" as="geometry"/></mxCell><mxCell id="n67" value="Readiness needs no outstanding recheck, so the event returns to the safety check only after every flag is confirmed." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#FFF4CC;strokeColor=#B8A13A;" vertex="1" parent="1"><mxGeometry x="88" y="2267" width="1404" height="25" as="geometry"/></mxCell><mxCell id="k68" value='&lt;table style="border-collapse:collapse;font-size:10px"&gt;&lt;tr&gt;&lt;td style="border:1px solid #BBBBBB;padding:2px 6px;"&gt;&lt;b&gt;Colour&lt;/b&gt;&lt;/td&gt;&lt;td style="border:1px solid #BBBBBB;padding:2px 6px;"&gt;&lt;b&gt;Meaning&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BBBBBB;padding:2px 6px;background:#FFF4CC;"&gt;&lt;/td&gt;&lt;td style="border:1px solid #BBBBBB;padding:2px 6px;"&gt;«Week 7» addition&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;strokeColor=#BBBBBB;fillColor=#FFFFFF;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="90" width="148" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram>
