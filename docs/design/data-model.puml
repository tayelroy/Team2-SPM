@startuml er-equipment-notifications
!pragma layout smetana
title ConnectSphere data model (4/6): equipment & notifications (public schema)\nas of main 4881413 (3 Nov 2026)
hide circle
hide empty members
skinparam shadowing false
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #FFFFFF
  BackgroundColor<<Week 7>> #FFF4CC
  BackgroundColor<<ref>> #E8F0FE
}

entity "events" as ev_ref <<ref>> {
  * event_id : serial <<PK>>
  .. page 1 ..
}
entity "venues" as venue_ref <<ref>> {
  * venue_id : serial <<PK>>
  .. page 2 ..
}
entity "venue_booking_requests" as vbr_ref <<ref>> {
  * request_id : bigserial <<PK>>
  .. page 3 ..
}
entity "users" as users_ref <<ref>> {
  * user_id : uuid <<PK>>
  .. page 1 ..
}

entity equipment {
  * equipment_id : serial <<PK>>
  --
  * name : varchar(255)  (not blank)
  * quantity_total : integer = 0  CHECK >= 0
  * description : text = 'Not recorded'
  * location : text = 'Not recorded'
  * operational_status : text = 'operational'
      CHECK in (operational, damaged, maintenance)
  * version : bigint = 1
  available_quantity : integer  GENERATED STORED
}

entity equipment_requests {
  * request_id : bigserial <<PK>>
  --
  * event_id : integer <<FK events>> cascade
  * equipment_id : integer <<FK equipment>>
  * quantity : integer  CHECK > 0
  starts_at, ends_at : timestamptz  (both or neither)
  * status : text = 'pending'  CHECK in (pending,
      approved, rejected, cancelled)
  notes : text
  arrangement_notes : text  (<= 2000)
  shortfall : integer  CHECK 0..quantity
  placement_venue_id : integer <<FK venues>>
  placement_position : text  (pair with venue)
  * version : bigint = 1
  .. indexes ..
  (event_id) «202610260002 SG2-96»
  .. rule (202610290003, in manage_equipment_requirements) ..
  placement venue must have a pending/approved request or a
  confirmed booking for the same event
}

entity equipment_reservations {
  * reservation_id : serial <<PK>>
  --
  * event_id : integer <<FK events>> cascade
  * equipment_id : integer <<FK equipment>>
  * quantity_reserved : integer
  starts_at, ends_at : timestamptz  (both or neither)
  request_id : bigint <<UQ>> <<FK equipment_requests>>
  reserved_at : timestamptz
  released_at : timestamptz
  released_by : uuid <<FK users>> set null
  release_reason : text  (1..500)
      «202610210001_equipment_release (SG2-56)»
  .. checks ..
  released_at <=> release_reason
  .. indexes ..
  (equipment_id, event_id); (event_id) «202610260002 SG2-96»
  .. triggers ..
  release_cancelled_event_equipment: on events.status -> cancelled
}

entity notifications {
  * notification_id : bigserial <<PK>>
  --
  * recipient_id : uuid <<FK users>> cascade
  event_id : integer <<FK events>> cascade
  request_id : bigint <<FK venue_booking_requests>> cascade
  equipment_reservation_id : integer
      <<FK equipment_reservations>> cascade
  * kind : text  CHECK in (30 kinds, see legend)
  * message : text  (1..2000)
  * created_at : timestamptz = clock_timestamp()
  read_at : timestamptz  «202610200003 SG2-69»
  UNIQUE (request_id, recipient_id, kind)
  UNIQUE (equipment_reservation_id, recipient_id)
  .. indexes ..
  (recipient_id) WHERE read_at IS NULL;
  (recipient_id, created_at DESC, notification_id DESC)
}

entity notification_reminder_settings {
  * user_id : uuid <<PK>> <<FK users>> cascade
  --
  * frequency_days : integer = 1  CHECK 1..30
  .. «202610200003_notifications_inbox_reminders (SG2-69)» ..
  .. grants to service_role only; coordinator's reminder cadence ..
}

entity notification_reminder_receipts {
  * event_id : integer <<PK>> <<FK events>> cascade
  * recipient_id : uuid <<PK>> <<FK users>> cascade
  --
  * last_sent_at : timestamptz
  .. «202610200003 (SG2-69)», grants to service_role only ..
  .. written by send_outstanding_arrangement_reminders() ..
}

ev_ref ||--o{ equipment_requests
ev_ref ||--o{ equipment_reservations
equipment ||--o{ equipment_requests
equipment ||--o{ equipment_reservations
venue_ref |o--o{ equipment_requests : placement_venue_id
equipment_requests |o--o| equipment_reservations : request_id
users_ref ||--o{ notifications : recipient_id
ev_ref |o--o{ notifications
vbr_ref |o--o{ notifications : request_id
equipment_reservations |o--o{ notifications : equipment_reservation_id
users_ref ||--o| notification_reminder_settings : user_id
