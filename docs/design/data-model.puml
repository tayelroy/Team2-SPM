  |= Marker |= Meaning |
  | ● (source *) | NOT NULL |
  |<back:#FFF4CC> «W7 migration» </back>| added by a Week 7 migration |
  |<back:#E8F0FE> <<ref>> </back>| defined on another page |
  notifications.kind (30), in the order they were added: venue_request_approved,
  venue_request_rejected, venue_booking_released, equipment_reserved
  (202610060001-202610140001), venue_booking_clash (W7 202610140003), event_confirmed
  (202610150001), event_submitted, coordinator_assigned, clarification_requested,
  event_approved, event_rejected (202610160001), venue_unavailable (W7 202610170001),
  event_returned_to_planning (202610190003), safety_decision (W7 202610190005),
  outstanding_arrangements (202610200003), registration_opened, registration_closed
  (202610200004), venue_booking_cancelled, venue_change_requested (W7 202610210002),
  cancellation_requested, event_cancelled (202610220002), registration_confirmed
  (202610230001), change_requested (202610260001), registration_withdrawn
  (202610260003), change_accepted, change_refused (202610270001), event_changed
  (202610270002), registration_full, waiting_list_offer, waiting_list_offer_lapsed
  (202610280001). From 202610200004 each migration appends its kinds to the live check; earlier ones restated the list.
  Hold notices live in venue_hold_notifications (page 3); the SG2-69 inbox reads both tables.
  Migration tags without W7 (e.g. 202610200003 SG2-69) = later backlog stories, not Week 7 changes.
endlegend
@enduml

@startuml er-registrations
!pragma layout smetana
title ConnectSphere data model (5/6): registrations & waiting list (public and private schema)\nas of main 4881413 (3 Nov 2026)
hide circle
hide empty members
skinparam shadowing false
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #FFFFFF
  BackgroundColor<<Week 7>> #FFF4CC
  BackgroundColor<<ref>> #E8F0FE
}

entity "events" as ev_ref <<ref>> {
  * event_id : serial <<PK>>
  .. page 1 ..
}
entity "users" as users_ref <<ref>> {
  * user_id : uuid <<PK>>
  .. page 1 ..
}

entity registrations {
  * registration_id : serial <<PK>>
  --
  * event_id : integer <<FK events>> cascade
  * attendee_id : uuid <<FK users>>
  status : varchar(50) = 'registered'
      ('cancelled' = withdrawn: gives the place back)
      «202610200004 SG2-63»
  * registered_at : timestamptz = clock_timestamp()
      «202610200004 SG2-63»
  contact_phone : text  CHECK <= 40, 8 Singapore digits,
      optional +65  «202610230001 SG2-60»
  needs : text  CHECK <= 500  «202610230001 SG2-60»
  withdrawn_at : timestamptz  CHECK => status cancelled
      «202610260003 SG2-62»
  .. indexes ..
  (event_id, status) «202610200004»
  UNIQUE (event_id, attendee_id) WHERE status <> 'cancelled'
      «202610230001»: one active registration per attendee
}

entity waiting_list_entries {
  * entry_id : bigserial <<PK>>
  --
  * event_id : integer <<FK events>> cascade
  * attendee_id : uuid <<FK users>> cascade
  * status : text = 'waiting'  CHECK in (waiting, offered,
      registered, left, lapsed)
  * joined_at : timestamptz = clock_timestamp()
  offered_at : timestamptz
  offer_expires_at : timestamptz
  ended_at : timestamptz
  .. checks ..
  offered => offered_at and offer_expires_at;
  ended_at null <=> status in (waiting, offered)
  .. indexes ..
  UNIQUE (event_id, attendee_id) WHERE status in (waiting, offered)
  (event_id, joined_at, entry_id) WHERE status in (waiting, offered)
  .. «202610280001_waiting_list (SG2-61/62)», select granted to service_role only ..
}

entity "private.event_attendee_details" as ead {
  * event_id : integer <<PK>> <<FK events>> cascade
  --
  proposed_date : timestamptz
  * venue_ids : integer[] = '{}'
  venue_names : text
  .. «202610270002_attendee_event_change_notices (SG2-102)» ..
  .. no grants or policies: only SECURITY DEFINER functions touch it ..
}

ev_ref ||--o{ registrations
users_ref ||--o{ registrations : attendee_id
ev_ref ||--o{ waiting_list_entries
users_ref ||--o{ waiting_list_entries : attendee_id
ev_ref ||--o| ead

legend bottom left
  |= Marker |= Meaning |
  | ● (source *) | NOT NULL |
  |<back:#E8F0FE> <<ref>> </back>| defined on another page |
  All tables on this page come from backlog stories after the Week 7 changes (no W7 tint).
  A place is held by an active registration (status <> 'cancelled') or an unexpired waiting-list offer
  (private.places_held). Every place-changing function locks the event row first.
  events.registration_capacity / registration_opens_at / registration_closes_at /
  registration_announced / waiting_list_response_hours: page 1.
  pg_cron jobs 'registration-windows' (process_registration_windows) and 'waiting-list-offers'
  (process_waiting_list_offers) run every minute.
  After commit, a deferred constraint trigger compares events.proposed_date and the event's
  confirmed venues with private.event_attendee_details and sends one event_changed notice
  to each active registration (notifications, page 4).
endlegend
@enduml

@startuml er-safety-changes
!pragma layout smetana
title ConnectSphere data model (6/6): safety decisions & change requests (public schema)\nas of main 4881413 (3 Nov 2026)
hide circle
hide empty members
skinparam shadowing false
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #FFFFFF
  BackgroundColor<<Week 7>> #FFF4CC
  BackgroundColor<<ref>> #E8F0FE
}

entity "events" as ev_ref <<ref>> {
  * event_id : serial <<PK>>
  .. page 1 ..
}
entity "users" as users_ref <<ref>> {
  * user_id : uuid <<PK>>
  .. page 1 ..
}
entity "venue_booking_requests" as vbr_ref <<ref>> {
  * request_id : bigserial <<PK>>
  .. page 3 ..
}
entity "equipment_requests" as eqr_ref <<ref>> {
  * request_id : bigserial <<PK>>
  .. page 4 ..
}

entity event_safety_decisions <<Week 7>> {
  * decision_id : bigserial <<PK>>
  --
  * event_id : integer <<FK events>> cascade
  * decision : text  CHECK in (approve, reject, request_changes)
  reason : text  CHECK <= 2000
  * arrangements : text[] = '{}'  CHECK subset of
      (venue, equipment, other)
  * decided_by : uuid <<FK users>>
  * decided_at : timestamptz = clock_timestamp()
  .. checks ..
  request_changes <=> arrangements not empty;
  reject / request_changes => reason not blank
  .. indexes ..
  (event_id, decided_at DESC)
  .. «W7 202610190005_safety_decisions (SG2-92)» ..
  .. append-only: select + insert granted to service_role only ..
}

entity safety_rereviews <<Week 7>> {
  * review_id : bigint <<PK>> (identity)
  --
  * event_id : integer <<FK events>> cascade
  * decision_id : bigint <<FK event_safety_decisions>> cascade
  * arrangement : text  CHECK in (venue, equipment)
  venue_request_id : bigint <<FK venue_booking_requests>> cascade
  equipment_request_id : bigint <<FK equipment_requests>> cascade
  * flagged_at : timestamptz = clock_timestamp()
  resolution : text  CHECK in (confirmed, withdrawn)
  resolved_by : uuid <<FK users>>
  resolved_at : timestamptz
  .. checks ..
  exactly one request, matching arrangement;
  resolution <=> resolved_at; confirmed => resolved_by
  .. indexes ..
  UNIQUE (venue_request_id) WHERE resolved_at IS NULL;
  UNIQUE (equipment_request_id) WHERE resolved_at IS NULL;
  (event_id, review_id)
  .. «W7 202610240001_safety_changes_requested (SG2-93)» ..
  .. select, insert, update granted to service_role only ..
}

entity event_change_requests {
  * change_request_id : bigserial <<PK>>
  --
  * event_id : integer <<FK events>> cascade
  * requested_by : uuid <<FK users>>
  * field : text  CHECK in (proposed_date, expected_attendance,
      venue_requirements, accessibility_needs,
      equipment_requirements, name, purpose, description)
  from_value : jsonb  (value when raised)
  * to_value : jsonb
  * reason : text  CHECK not blank, <= 1000
  * status : text = 'pending'  CHECK in (pending,
      accepted, refused)
  * created_at : timestamptz = now()
  decided_by : uuid <<FK users>>
  decided_at : timestamptz
  decision_reason : text  (required when refused, <= 1000)
      «202610270001_change_request_decisions (SG2-65)»
  .. checks ..
  pending <=> decided_by null <=> decided_at null
  .. indexes ..
  (event_id, created_at)
  .. «202610260001_event_change_requests (SG2-64)» ..
  .. select, insert, update granted to service_role only ..
}

ev_ref ||--o{ event_safety_decisions
users_ref ||--o{ event_safety_decisions : decided_by
event_safety_decisions ||--o{ safety_rereviews
ev_ref ||--o{ safety_rereviews
vbr_ref |o--o| safety_rereviews : venue_request_id (open flag)
eqr_ref |o--o| safety_rereviews : equipment_request_id (open flag)
ev_ref ||--o{ event_change_requests
users_ref ||--o{ event_change_requests : requested_by / decided_by

legend bottom left
  |= Marker |= Meaning |
  | ● (source *) | NOT NULL |
  |<back:#FFF4CC> <<Week 7>> / «W7 migration» </back>| Week 7 change #6, operational safety check |
  |<back:#E8F0FE> <<ref>> </back>| defined on another page |
  event_change_requests comes from SG2-64/65 (backlog, no W7 tint).
  safety_rereviews.resolved_by -> users: line omitted.
  Outstanding rechecks are keys in events.outstanding_arrangements (page 1): venue_recheck,
  equipment_recheck, registration_recheck (SG2-66) and safety_venue_recheck,
  safety_equipment_recheck, safety_other_recheck (SG2-93, SG2-92 rework).
  events.awaiting_safety_check_since and safety_check_revision (page 1) let a decision refuse
  a stale review (202610190006); safety_approval_gate allows Preparation only after Approve (202610220001).
endlegend
@enduml
