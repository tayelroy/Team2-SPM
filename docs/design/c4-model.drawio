ml=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1095" y="1095" width="280" height="120" as="geometry"/></mxCell></object><object id="e33" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Row Level Security" c4Type="Container" c4Description="Policies on public tables limit an authenticated caller to rows their role may see or change (defence in depth behind the API's checks)." c4Technology="PostgreSQL RLS policies" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1440" y="1093" width="280" height="124" as="geometry"/></mxCell></object><object id="e34" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="SECURITY DEFINER RPCs &amp; triggers" c4Type="Container" c4Description="Concurrency-sensitive writes lock rows and recheck the caller's role: decide/withdraw/release bookings, holds, confirm_event, equipment requirements/reservations; disruption triggers notify and return Preparation/Confirmed to Planning; confirmation rechecks persisted flags and affected bookings (202610170002)." c4Technology="PL/pgSQL functions" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="479" y="1048" width="280" height="214" as="geometry"/></mxCell></object><object id="e35" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Postgres tables" c4Type="Container (Database)" c4Description="public schema: events, venues, venue_booking_requests, venue_bookings, venue_holds, venue_unavailability, venue_operations, equipment, notifications, event_audit_logs, account_roles, ..." c4Technology="PostgreSQL (Supabase)" tags="Container Database"><mxCell style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="749" y="1367" width="280" height="162" as="geometry"/></mxCell></object><object id="e36" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Scheduled jobs" c4Type="Container" c4Description="pg_cron: 'venue-hold-deadlines' every minute warns before a hold expires and expires it (SG2-85); 'registration-windows' every minute opens and closes registration (SG2-63); 'sg2-69-arrangement-reminders' hourly reminds coordinators of outstanding arrangements (SG2-69)." c4Technology="pg_cron" tags="Container Week_7"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#B07612;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="479" y="744" width="280" height="166" as="geometry"/></mxCell></object><mxCell id="r103" value='Raises and tracks event&lt;br&gt;requests&lt;br&gt;&lt;font color="#666666"&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;/font&gt;' style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;rounded=1;edgeStyle=none;jumpStyle=arc;jumpSize=12;labelBackgroundColor=#ffffff;metaEdit=1;" edge="1" parent="1" source="e1" target="e9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="312" y="358"/><mxPoint x="434" y="438"/></Array><mxPoint x="-59" y="-41" as="offset"/></mxGeometry></mxCell><mxCell id="r104" value='Reviews, plans and books&lt;br&gt;&lt;font color="#666666"&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;/font&gt;' style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;rounded=1;edgeStyle=none;jumpStyle=arc;jumpSize=12;labelBackgroundColor=#ffffff;metaEdit=1;" edge="1" parent="1" source="e2" target="e9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="438"/></Array><mxPoint x="-26" y="-42" as="offset"/></mxGeometry></mxCell><mxCell id="r105" value='Assigns coordinators&lt;br&gt;&lt;font color="#666666"&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;&lt;/font&gt;' style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#C47F00;rounde