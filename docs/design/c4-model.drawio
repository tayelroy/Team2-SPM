inders." tags="Person"><mxCell style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;metaEdit=1;align=center;labelBackgroundColor=none;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="345" y="110" width="240" height="248" as="geometry"/></mxCell></object><object id="e3" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Event Coordinator Lead" c4Type="Person" c4Description="Assigns and reassigns coordinators from the unassigned queue (SG2-87/88/97); oversees assignments and active events (SG2-89)." tags="Person Week_7"><mxCell style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#B07612;metaEdit=1;align=center;labelBackgroundColor=none;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="650" y="114" width="240" height="240" as="geometry"/></mxCell></object><object id="e4" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Safety Officer" c4Type="Person" c4Description="Reviews events awaiting an operational safety check and approves, rejects or requests changes (SG2-91/92/93/94)." tags="Person Week_7"><mxCell style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#B07612;metaEdit=1;align=center;labelBackgroundColor=none;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,