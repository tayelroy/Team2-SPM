10170002)." c4Technology="PL/pgSQL functions" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2150" y="799" width="280" height="214" as="geometry"/></mxCell></object><object id="e35" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Postgres tables" c4Type="Container (Database)" c4Description="public schema: events, venues, venue_booking_requests, venue_bookings, venue_holds, venue_unavailability, venue_operations, equipment, notifications, event_audit_logs, account_roles, ..." c4Technology="PostgreSQL (Supabase)" tags="Container Database"><mxCell style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2666" y="591" width="280" height="162" as="geometry"/></mxCell></object><object id="e36" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Scheduled jobs" c4Type="Container" c4Description="pg_cron: 'venue-hold-deadlines' every minute warns before a hold expires and expires it (SG2-85); 'registration-windows' every minute opens and closes registration (SG2-63); 'sg2-69-arrangement-reminders' hourly reminds coordinators of outstanding arrangements (SG2-69)." c4Technology="pg_cron" tags="Container Week_7"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#B07612;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1559" y="988" width="280" height="166" as="geometry"/></mxCell></object><object id="e11" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="requireAuth / requirePermission" c4Type="Component" c4Description="Rejects requests without exactly one Bearer token; resolves the caller and every role they hold (auth.getUser + account_roles); picks the acting role from X-Acting-Role (SG2-104); checks the route's permission against the policy." c4Technology="auth/index.ts, auth/supabase.ts, auth/actingRole.ts" tags="Component"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="539" y="477" width="280" height="186" as="geometry"/></mxCell></object><object id="e16" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/d