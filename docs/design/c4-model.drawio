  <diagram id="page-3" name="C3 Components (1/5): request pipeline and auth"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl1" value="&lt;b&gt;C3 Components (1/5) - API Application: request pipeline and auth - as of main b7e2b1a (26 Oct 2026)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/></mxCell><object id="boundary" label='&lt;font style="font-size:16px"&gt;&lt;b&gt;API Application&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container]&lt;/div&gt;' placeholders="1" c4Name="API Application" c4Type="Container Boundary" c4Application="Container"><mxCell style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;connectable=0;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="511" y="118" width="855" height="462" as="geometry"/></mxCell></object><object id="e9" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Web Application" c4Type="Container" c4Description="React single-page app; one screen per task, role-specific dashboard. Served as static files by Vercel (server/public)." c4Technology="React 18 + TypeScript, Vite" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdi