  <diagram id="page-7" name="C3 Components (5/5): search, cancellation, registration"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl1" value="&lt;b&gt;C3 Components (5/5) - API Application: search, cancellation, registration - as of main b7e2b1a (26 Oct 2026)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/></mxCell><object id="boundary" label='&lt;font style="font-size:16px"&gt;&lt;b&gt;API Application&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container]&lt;/div&gt;' placeholders="1" c4Name="API Application" c4Type="Container Boundary" c4Application="Container"><mxCell style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;connectable=0;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="511" y="118" width="1362" height="488" as="geometry"/></mxCell></object><object id="e9" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Web Application" c4Type="Container" c4Description="React single-page app; one screen per task, role-specific dashboard. Served as static files by Vercel (server/public)." c4Technology="React 18 + TypeScript, Vite" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="40" y="339" width="280" height="120" as="geometry"/></mxCell></object><object id="e33" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Row Level Security" c4Type="Container" c4Description="Policies on public tables limit an authenticated caller to rows their role may see or change (defence in depth behind the API's checks)." c4Technology="PostgreSQL RLS policies" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2156" y="412" width="280" height="124" as="geometry"/></mxCell></object><object id="e34" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="SECURITY DEFINER RPCs &amp; triggers" c4Type="Container" c4Description="Concurrency-sensitive writes lock rows and recheck the caller's role: decide/withdraw/release bookings, holds, confirm_event, equipment requirements/reservations; disruption triggers notify and return Preparation/Confirmed to Planning; confirmation rechecks persisted flags and affected bookings (202610170002)." c4Technology="PL/pgSQL functions" tags="Container"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2156" y="601" width="280" height="214" as="geometry"/></mxCell></object><object id="e35" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Postgres tables" c4Type="Container (Database)" c4Description="public schema: events, venues, venue_booking_requests, venue_bookings, venue_holds, venue_unavailability, venue_operations, equipment, notifications, event_audit_logs, account_roles, ..." c4Technology="PostgreSQL (Supabase)" tags="Container Database"><mxCell style="shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;metaEdit=1;align=center;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2672" y="393" width="280" height="162" as="geometry"/></mxCell></object><object id="e36" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="Scheduled jobs" c4Type="Container" c4Description="pg_cron: 'venue-hold-deadlines' every minute warns before a hold expires and expires it (SG2-85); 'registration-windows' every minute opens and closes registration (SG2-63); 'sg2-69-arrangement-reminders' hourly reminds coordinators of outstanding arrangements (SG2-69)." c4Technology="pg_cron" tags="Container Week_7"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#B07612;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1565" y="639" width="280" height="166" as="geometry"/></mxCell></object><object id="e11" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' placeholders="1" c4Name="requireAuth / requirePermission" c4Type="Component" c4Description="Rejects requests without exactly one Bearer token; resolves the caller and every role they hold (auth.getUser + account_roles); picks the acting role from X-Acting-Role (SG2-104); checks the route's permission against the policy." c4Technology="auth/index.ts, auth/supabase.ts, auth/actingRole.ts" tags="Component"><mxCell style="rounded=1;arcSize=10;labelBackgroundColor=none;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#5D82A8;metaEdit=1;align=center;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[1,1,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="539" y="306" width="280" height="186" as="geometry"/></mxCell></object><object id="e27" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#333333"&gt;%c4Description%&lt;/font&gt;&lt;/font