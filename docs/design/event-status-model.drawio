<mxfile host="app.diagrams.net" agent="ConnectSphere design" version="24.7.17">
  <diagram id="page-1" name="Event status model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl1" value='&lt;b&gt;Event status model — generated from STATUS_TRANSITIONS (server/src/events/fields.ts)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;as of main b7e2b1a (26 Oct 2026)&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="60" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1707" y="115" width="20" height="20" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="688" y="1447" width="24" height="24" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;draft&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1657" y="222" width="120" height="44" as="geometry"/></mxCell><mxCell id="unassigned" value='&lt;font style="font-size:9px"&gt;«Week 7»&lt;/font&gt;&lt;br&gt;&lt;b&gt;unassigned&lt;/b&gt;' style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF4CC;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="1534" y="328" width="120" height="44" as="geometry"/></mxCell><mxCell id="submitted" value="&lt;b&gt;submitted&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1383" y="434" width="120" height="44" as="geometry"/></mxCell><mxCell id="under_review" value="&lt;b&gt;under_review&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1332" y="540" width="120" height="44" as="geometry"/></mxCell><mxCell id="needs_clarification" value="&lt;b&gt;needs_clarification&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1045" y="646" width="173" height="44" as="geometry"/></mxCell><mxCell id="rejected" value="&lt;b&gt;rejected&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1666" y="646" width="120" height="44" as="geometry"/></mxCell><mxCell id="approved" value="&lt;b&gt;approved&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1299" y="646" width="120" height="44" as="geometry"/></mxCell><mxCell id="planning" value="&lt;b&gt;planning&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1130" y="752" width="120" height="44" as="geometry"/></mxCell><mxCell id="awaiting_safety_check" value='&lt;font style="font-size:9px"&gt;«Week 7»&lt;/font&gt;&lt;br&gt;&lt;b&gt;awaiting_safety_check&lt;/b&gt;' style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF4CC;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="1097" y="886" width="187" height="44" as="geometry"/></mxCell><mxCell id="safety_rejected" value='&lt;font style="font-size:9px"&gt;«Week 7»&lt;/font&gt;&lt;br&gt;&lt;b&gt;safety_rejected&lt;/b&gt;' style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF4CC;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="1144" y="1050" width="142" height="44" as="geometry"/></mxCell><mxCell id="preparation" value='&lt;font style="font-size:9px"&gt;«Week 7»&lt;/font&gt;&lt;br&gt;&lt;b&gt;preparation&lt;/b&gt;' style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF4CC;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="151" y="1050" width="120" height="44" as="geometry"/></mxCell><mxCell id="confirmed" value="&lt;b&gt;confirmed&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="182" y="1210" width="120" height="44" as="geometry"/></mxCell><mxCell id="completed" value="&lt;b&gt;completed&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="182" y="1356" width="120" height="44" as="geometry"/></mxCell><mxCell id="cancelled" value="&lt;b&gt;cancelled&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1155" y="1356" width="120" height="44" as="geometry"/></mxCell><mxCell id="note0" value="202610170001: a new disruption flag returns Preparation/Confirmed&lt;br&gt;to Planning, clears confirmed_by/at, writes history and notifies&lt;br&gt;the Coordinator and Organiser. Other event details remain.&lt;br&gt;202610170002: confirmation refuses affected bookings AND&lt;br&gt;persisted venue/equipment/registration rechecks.&lt;br&gt;202610220001 (SG2-94): confirmation also needs the latest safety&lt;br&gt;decision to be Approve; leaving Preparation/Confirmed withdraws it." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFBE6;strokeColor=#B8A13A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="473" y="1176" width="399" height="112" as="geometry"/></mxCell><mxCell id="note1" value="SG2-67: the organiser asks (POST /:id/cancellation-request),&lt;br&gt;the assigned coordinator cancels; tentative holds and pending&lt;br&gt;requests are released and SG2-56 releases the equipment." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFBE6;strokeColor=#B8A13A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1447" y="1350" width="366" height="56" as="geometry"/></mxCell><mxCell id="note2" value="15 Oct (SG2-66): once an event is in Preparation or Confirmed&lt;br&gt;its details are read-only; a change goes through a change&lt;br&gt;request (raising and deciding it is planned, SG2-64/65) and an&lt;br&gt;accepted significant change returns the event to Planning,&lt;br&gt;where every check, the safety check included, runs again." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFBE6;strokeColor=#B8A13A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="442" y="1030" width="371" height="84" as="geometry"/></mxCell><mxCell id="note3" value="Handlers do not call canTransition(); STATUS_TRANSITIONS&lt;br&gt;documents the intended flow. Any non-terminal event&lt;br&gt;(incl. submitted / under_review / needs_clarification)&lt;br&gt;returns to planning on an impacting planning edit." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#FFFBE6;strokeColor=#B8A13A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1770" y="90" width="338" height="70" as="geometry"/></mxCell><mxCell id="t0" value="POST /api/event-requests&lt;br&gt;(eventDraftHandler)" style="html=1;endArrow=open;endSize=9;fontSize=10;rounded=1;edgeStyle=none;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#404040;" edge="1" parent="1" source="start" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="62" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="t1" value="PATCH /:id/submit&lt;br&gt;(submitEventRequest, no coordinator)" style="html=1;endArrow=open;endSize=9;fontSize=10;rounded=1;edgeStyle=none;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#404040;" edge="1" parent="1" source="draft" target="unassigned"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="104" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t2" value="POST /:id/cancel&lt;br&gt;(cancel_event, SG2-67)" style="html=1;endArrow=open;endSize=9;fontSize=10;rounded=1;edgeStyle=none;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#404040;" edge="1" parent="1" source="draft" target="cancelled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1862" y="286"/><mxPoint x="1989" y="349"/><mxPoint x="1989" y="1233"/><mxPoint x="1761" y="1288"/></Array><mxPoint x="57" y="-318" as="offset"/></mxGeometry></mxCell><mxCell id="t3" value="PATCH /:id/coordinator&lt;br&gt;(assignCoordinatorHandler, SG2-97)" style="html=1;endArrow=open;endSize=9;fontSize=10;rounded=1;edgeStyle=none;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#404040;" edge="1" parent="1" source="unassigned" target="submitted"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="102" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t4" value="PATCH /:id/review&lt;br&gt;(startEventReviewHandler)" style="html=1;endArrow=open;endSize=9;fontSize=10;rounded=1;edgeStyle=none;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#404040;" edge="1" parent="1" source="submitted" target="under_review"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="71" y="-0" as="offset"/></mxGeometry></mxCell><mxCell id="t5" value="POST /:id/clarifications&lt;br&gt;(requestClarification)" style="html=1;endArrow=open;endSize=9;fontSize=10;rounded=1;edgeStyle=none;labelBackgroundColor=#ffffff;strokeColor=#444444;fontColor=#404040;" edge="1" parent="1" source="under_review" target="needs_clarification"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="604"/></Array><mxPoint x="45" y="13" as="offset"/></mxGeometry></mxCell><m