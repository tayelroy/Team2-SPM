{
  "all": true,
  "src": ["src", "api"],
  "include": ["src/**/*.ts", "api/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.d.ts", "api/**/*.test.ts", "api/**/*.d.ts"],
  "exclude-after-remap": true,
  "reporter": ["text", "html", "lcovonly", "json-summary"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "per-file": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 80
}
